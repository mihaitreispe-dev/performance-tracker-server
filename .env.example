# Apps
API_V1_MODULE_ENABLED=Y
API_V1_PORT=5100
CRON_MODULE_ENABLED=Y
# API URL
API_V1_URL=http://192.168.100.92:5100

# Auth
# generate using: openssl rand -base64 32 | tr -d /=+ | cut -c -32
JWT_ACCESS_TOKEN_SECRET=JWT_ACCESS_TOKEN_SECRET
JWT_ACCESS_TOKEN_EXPIRY=5m
# generate using: openssl rand -base64 32 | tr -d /=+ | cut -c -32
JWT_REFRESH_TOKEN_SECRET=JWT_REFRESH_TOKEN_SECRET
JWT_REFRESH_TOKEN_EXPIRY=

# Database
DB_HOST=localhost
# Host-side port (what `pnpm migrate:*` / scripts dial against). Keep in
# sync with DB_EXTERNAL_PORT below so docker-compose's host:container
# mapping matches what host-side tooling expects.
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSL=N
# Host-side postgres port published by docker-compose. Default 5433 (not
# 5432) so the project plays nicely with a native postgres / another
# dockerised project already on 5432.
DB_EXTERNAL_PORT=5433

# Local MinIO defaults (see docker-compose.yml). For a real AWS account,
# replace these with your AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
AWS_ACCESS_KEY=minioroot
AWS_SECRET_KEY=minioroot

# Point at the local MinIO published on host port 9002. The api container
# reaches it through the docker network bridge; the browser hits the same
# URL for presigned uploads/downloads.
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_UPLOAD_BUCKET=uploads
S3_CONTENT_BUCKET=content

CDN_URL=http://localhost:9002
DISABLE_CDN=Y

# Optional MinIO host-port overrides (defaults: 9002 API, 9003 console)
# MINIO_API_PORT=9002
# MINIO_CONSOLE_PORT=9003

# MinIO CORS — origin(s) allowed to PUT to presigned upload URLs from a browser.
# Defaults to `*` for local dev. In production, set to your client origin(s),
# e.g. https://app.example.com,https://staging.example.com
# MINIO_CORS_ALLOW_ORIGIN=*

# MediaConvert
MEDIA_CONVERT_REGION=us-east-1
MEDIA_CONVERT_ROLE=
MEDIA_CONVERT_QUEUE=
DISABLE_MEDIA_CONVERT=Y

# Smart crop (Rekognition body-detect) — optional, defaults off (N). When Y,
# the 16:9 companion rendition is cropped to frame the detected person
# instead of letterboxing. Detection runs async in the background, so the
# upload-completion/reprocess request returns immediately. Requires the AWS
# credentials above to also have rekognition:StartLabelDetection +
# rekognition:GetLabelDetection and read access to the upload bucket.
ENABLE_SMART_CROP=N

# Local ffmpeg transcode — MediaConvert stand-in for local dev. When Y,
# exercise uploads are transcoded locally (ffmpeg → MinIO at the production
# keys → assets_done) instead of submitting a MediaConvert job. Pair with
# DISABLE_MEDIA_CONVERT=Y. Requires ffmpeg on PATH and a reachable MinIO with
# a public-read content bucket. Smart crop (Rekognition) has no local
# equivalent, so LOCAL_TRANSCODE_WIDE_MODE picks how the 16:9 frame is filled.
ENABLE_LOCAL_TRANSCODE=N
# pad (letterbox, default) | crop (centre-crop, approximates smart crop)
LOCAL_TRANSCODE_WIDE_MODE=pad

FIREBASE_PROJECT_ID=performance-tracker-staging
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Strava Integration
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:5100/v1/integrations/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Garmin Integration
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
GARMIN_REDIRECT_URI=http://localhost:5100/v1/integrations/garmin/callback

# OpenWearables Integration
# When using Docker, this should be http://openwearables:8000/api/v1
OPENWEARABLES_API_URL=http://localhost:8000/api/v1
# API key from the OpenWearables admin panel
OPENWEARABLES_API_KEY=

# OpenWearables Database (separate from main DB)
OW_DB_NAME=openwearables

# OpenWeather API (Race Weather Forecasts)
# Get a free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# WorkoutX (workoutxapp.com) — only consumed by the one-shot ingestion script
# at src/scripts/import-from-workoutx.ts. Local-dev only; the free tier is
# 500 requests/month and the data licence does not permit commercial
# redistribution. Sign up + grab the X-WorkoutX-Key value here.
WORKOUTX_API_KEY=

{
  "name": "performance-tracker-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "DEBUG=true NODE_OPTIONS='--enable-source-maps --experimental-repl-await' nest start --debug 9230 --watch",
    "build": "nest build && tsc-alias",
    "start:build": "NODE_OPTIONS='--enable-source-maps' node dist/main",
    "lint": "eslint '*/**/*.{js,cjs,mjs,ts,tsx}' --report-unused-disable-directives",
    "format": "pnpm lint --quiet --fix",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migrate:latest": "kysely migrate:latest",
    "migrate:up": "kysely migrate:up",
    "migrate:down": "kysely migrate:down",
    "migrate:rollback": "kysely migrate:rollback",
    "migrate:list": "kysely migrate:list",
    "migrate:make": "kysely migrate:make",
    "seed": "kysely seed",
    "seed:make": "kysely seed:make",
    "cli": "ts-node -r tsconfig-paths/register src/cli.ts",
    "openapi:extract": "ts-node -r tsconfig-paths/register src/extract-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-mediaconvert": "^3.981.0",
    "@aws-sdk/client-rekognition": "^3.1054.0",
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/cloudfront-signer": "^3.978.0",
    "@aws-sdk/lib-storage": "^3.980.0",
    "@aws-sdk/s3-request-presigner": "^3.980.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/terminus": "^11.0.0",
    "@types/adm-zip": "^0.5.7",
    "@types/multer": "^2.0.0",
    "@xmldom/xmldom": "^0.8.11",
    "adm-zip": "^0.5.16",
    "app-root-path": "^3.1.0",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express-basic-auth": "^1.2.1",
    "firebase-admin": "^13.6.0",
    "fit-file-parser": "^2.3.3",
    "helmet": "^8.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "kysely": "^0.28.11",
    "kysely-codegen": "^0.19.0",
    "kysely-ctl": "^0.20.0",
    "lodash": "^4.17.23",
    "nestjs-console": "^10.0.0",
    "nestjs-kysely": "^3.1.2",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.1.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/json2csv": "^5.0.7",
    "@types/lodash": "^4.17.23",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/__tests__/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup.ts"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}

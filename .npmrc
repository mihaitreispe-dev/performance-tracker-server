# Hoist all dependencies to a flat node_modules, like npm/yarn.
#
# The app directly imports a few packages that are only present
# transitively (express via @nestjs/platform-express, etc.). pnpm's
# default strict, symlinked layout doesn't expose those at the top
# level, so `require('express')` resolves in local dev (where things
# happen to be hoisted) but FAILS in the clean `pnpm install --prod`
# the Docker image runs — crashing the container at boot.
#
# shamefully-hoist makes the prod install match local resolution, so
# anything the code can import locally it can import in the container.
# Explicit deps are still declared where known (express, jsonwebtoken,
# ms) as proper hygiene; this is the safety net for the rest.
shamefully-hoist=true
